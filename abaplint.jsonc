{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      // the downported abap2UI5 (branch 702 is generated from main)
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "702",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    },
    {
      // the downported popups (its 702 branch)
      "url": "https://github.com/abap2UI5-addons/popups",
      "branch": "702",
      "folder": "/popups",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2xlsx/abap2xlsx",
      "folder": "/abap2xlsx",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "uncaught_exception": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
