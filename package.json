{
  "name": "abap2ui5-table-content-loader",
  "private": true,
  "version": "1.0.0",
  "description": "Upload, edit and download table content (JSON, CSV, XLSX), built with abap2UI5.",
  "scripts": {
    "rename": "abaplint .github/abaplint/rename.json --rename",
    "lint": "abaplint ./abaplint.jsonc",
    "check:cloud": "abaplint .github/abaplint/abap_cloud.jsonc",
    "check:abap2ui5": "abap2ui5lint",
    "check": "npm run lint && npm run check:cloud && npm run check:abap2ui5 && npm run rename",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/table-content-loader.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5-addons/table-content-loader/issues"
  },
  "homepage": "https://github.com/abap2UI5-addons/table-content-loader#readme",
  "devDependencies": {
    "@abaplint/cli": "^2.119.66",
    "@abap2ui5/linter": "^0.2.1",
    "@abap2ui5/render-runtime": "^0.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
